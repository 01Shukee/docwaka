# ── Database (Railway PostgreSQL) ────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# ── NextAuth v5 ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ── UploadThing ───────────────────────────────────────────────────────────────
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID="your-app-id"

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── First SYS_ADMIN (used by `npm run db:seed`, only if no admin exists) ──────
ADMIN_EMAIL="admin@docwaka.com"
ADMIN_PASSWORD="choose-a-strong-password"

# ── Email (SMTP) — real notification emails ──────────────────────────────────
# Any SMTP provider works. Examples:
#   Gmail:  smtp.gmail.com / 587  (use an App Password, needs 2-Step Verification)
#   Brevo:  smtp-relay.brevo.com / 587
#   Zoho:   smtp.zoho.com / 587
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"          # "true" for port 465
SMTP_USER="you@example.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="docwaka. <you@example.com>"
